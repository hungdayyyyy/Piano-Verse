{
  "name": "pianoverse-backend",
  "version": "1.0.0",
  "description": "Piano Verse AI - Production-ready backend API (JavaScript)",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "docker:build": "docker build -t pianoverse-backend:latest .",
    "docker:run": "docker run -p 3001:3001 pianoverse-backend:latest"
  },
  "dependencies": {
    "express": "4.21.0",
    "mongoose": "8.4.0",
    "redis": "4.7.0",
    "socket.io": "4.8.0",
    "jsonwebtoken": "9.1.2",
    "bcryptjs": "2.4.3",
    "bullmq": "5.7.0",
    "helmet": "7.1.0",
    "express-rate-limit": "7.4.0",
    "joi": "17.13.0",
    "dotenv": "16.4.5",
    "axios": "1.7.7",
    "openai": "4.38.0",
    "aws-sdk": "2.1627.0",
    "cors": "2.8.5",
    "morgan": "1.10.0",
    "multer": "1.4.5",
    "swagger-ui-express": "5.0.1",
    "swagger-jsdoc": "6.2.8",
    "lodash": "4.17.21"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "eslint": "8.57.0",
    "prettier": "3.3.0"
  }
}
